{
  "name": "trendchecker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "E-Commerce Intelligence SaaS Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "web:dev": "npm run dev --workspace=apps/web",
    "api:dev": "npm run dev --workspace=apps/api"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^1.13.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.2.4"
}
